<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/networkBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/warning"
            android:gravity="center"
            android:padding="12dp"
            android:text="现在没有网络，将使用上次更新的内容"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="早上好"
                    android:textColor="@color/accent_dark"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dateDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="2026年7月29日  星期三"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/settingsButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_round_outline"
                android:clickable="true"
                android:contentDescription="打开设置"
                android:focusable="true"
                android:gravity="center"
                android:text="设置"
                android:textColor="@color/accent_dark"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/bg_reading"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="#D8C5AC"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="每天自动播放"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/timeDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="修改每天播放时间"
                        android:focusable="true"
                        android:text="06:00"
                        android:textColor="@color/accent_dark"
                        android:textSize="38sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/alarmSwitch"
                    android:layout_width="72dp"
                    android:layout_height="64dp"
                    android:contentDescription="开启或关闭每天自动播放"
                    app:switchMinWidth="64dp"
                    app:useMaterialThemeColors="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/permissionWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="22dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="请允许精确闹钟，才能准时自动播放"
            android:textColor="@color/warning"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/testBroadcastButton"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="18dp"
            android:contentDescription="开始今天的晨间播报"
            android:text="▶  开始今天的播报"
            android:textAllCaps="false"
            android:textSize="23sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_dark"
            app:cornerRadius="24dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="22dp"
                    android:text="今天读什么"
                    android:textColor="@color/text_primary"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/biblePlanSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginStart="14dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:text="麦大卫一年读经  ▼"
                    android:textColor="@color/accent_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bibleProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="22dp"
                    android:paddingTop="4dp"
                    android:text="第 201 / 365 天"
                    android:textColor="@color/text_secondary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/bibleReadingPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="10dp"
                    android:paddingHorizontal="22dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="12dp"
                    android:text="1. 创世记第一章&#10;2. 马太福音第一章"
                    android:textColor="@color/text_primary"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/bibleProgressRow"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_day_navigation"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/biblePreviousDay"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:contentDescription="查看前一天"
                        android:text="‹  前一天"
                        android:textColor="@color/text_label"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/bibleDayPickerButton"
                        android:layout_width="72dp"
                        android:layout_height="64dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="选择计划日"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="选天数"
                        android:textColor="@color/accent_dark"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bibleNextDay"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:contentDescription="查看后一天"
                        android:text="后一天  ›"
                        android:textColor="@color/text_label"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#EDF3E7"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <TextView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:gravity="center"
                    android:text="☀"
                    android:textColor="@color/olive"
                    android:textSize="38sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="今天的天气"
                        android:textColor="@color/text_primary"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/weatherSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="正在更新…"
                        android:textColor="@color/text_primary"
                        android:textSize="21sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="22dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="今日三条要闻"
                    android:textColor="@color/text_primary"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/newsSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="8dp"
                    android:text="正在更新…"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_settings_panel"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="设置"
                android:textColor="@color/text_primary"
                android:textSize="27sp"
                android:textStyle="bold" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/moduleBible"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:checked="true"
                android:text="播放圣经"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                app:useMaterialThemeColors="true" />

            <RadioGroup
                android:id="@+id/planRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/planMcCheyne"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="麦大卫一年读经"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <RadioButton
                    android:id="@+id/planSequential"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="顺序读经"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <RadioButton
                    android:id="@+id/planChapterADay"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="每天三章"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />
            </RadioGroup>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/bibleEnglish"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/bibleRecordedAudio"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:checked="true"
                android:text="使用真人圣经朗读"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                app:useMaterialThemeColors="true" />

            <TextView
                android:id="@+id/bibleAudioStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="真人录音已准备"
                android:textColor="@color/text_secondary"
                android:textSize="17sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/importBibleAudioButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:text="导入真人圣经录音"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/chineseSpeechRateLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="播报速度：自然"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <SeekBar
                android:id="@+id/chineseSpeechRate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:max="50"
                android:progress="18" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/moduleWeather"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:checked="true"
                android:text="播放天气"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                app:useMaterialThemeColors="true" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/moduleNews"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:checked="true"
                android:text="播放三条新闻"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                app:useMaterialThemeColors="true" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/newsFullArticles"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:checked="false"
                android:text="播报新闻全文（时间较长）"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                app:useMaterialThemeColors="true" />

            <TextView
                android:id="@+id/locationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="天气位置未设置"
                android:textColor="@color/text_secondary"
                android:textSize="17sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/locationButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:text="允许获取天气位置"
                android:textSize="18sp"
                android:visibility="gone" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="48dp" />
    </LinearLayout>
</ScrollView>
