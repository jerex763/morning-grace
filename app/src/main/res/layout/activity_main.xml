<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/networkBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/warning"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/offline_banner"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greetingDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@string/greeting_placeholder"
                    android:textColor="@color/accent_dark"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dateDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/date_placeholder"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/settingsButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_round_outline"
                android:clickable="true"
                android:contentDescription="@string/open_settings"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/settings"
                android:textColor="@color/accent_dark"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/bg_reading"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="#D8C5AC"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/daily_auto_play"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/timeDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/change_daily_time"
                        android:focusable="true"
                        android:text="@string/time_placeholder"
                        android:textColor="@color/accent_dark"
                        android:textSize="38sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/alarmSwitch"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:contentDescription="@string/toggle_daily_play"
                    app:switchMinWidth="64dp"
                    app:useMaterialThemeColors="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/permissionWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="22dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/exact_alarm_warning"
            android:textColor="@color/warning"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/testBroadcastButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="86dp"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="18dp"
            android:contentDescription="@string/start_broadcast_description"
            android:text="@string/start_broadcast"
            android:textAllCaps="false"
            android:textSize="23sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_dark"
            app:cornerRadius="24dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="22dp"
                    android:text="@string/today_reading"
                    android:textColor="@color/text_primary"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/biblePlanSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginStart="14dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:text="@string/reading_plan_placeholder"
                    android:textColor="@color/accent_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bibleProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="22dp"
                    android:paddingTop="4dp"
                    android:text="@string/reading_progress_placeholder"
                    android:textColor="@color/text_secondary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/bibleReadingPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="10dp"
                    android:paddingHorizontal="22dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="12dp"
                    android:text="@string/reading_preview_placeholder"
                    android:textColor="@color/text_primary"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/bibleProgressRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_day_navigation"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/biblePreviousDay"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/previous_day_description"
                        android:text="@string/previous_day"
                        android:textColor="@color/text_label"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/bibleDayPickerButton"
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/choose_day_description"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/choose_day"
                        android:textColor="@color/accent_dark"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bibleNextDay"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/next_day_description"
                        android:text="@string/next_day"
                        android:textColor="@color/text_label"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#EDF3E7"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <TextView
                    android:id="@+id/weatherIcon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:gravity="center"
                    android:text="@string/weather_icon_default"
                    android:textColor="@color/olive"
                    android:textSize="38sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/today_weather"
                        android:textColor="@color/text_primary"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/weatherSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/updating"
                        android:textColor="@color/text_primary"
                        android:textSize="21sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="22dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/today_news"
                    android:textColor="@color/text_primary"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/newsSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="8dp"
                    android:text="@string/updating"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_settings_panel"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:textColor="@color/text_primary"
                android:textSize="27sp"
                android:textStyle="bold" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/moduleBible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:checked="true"
                android:text="@string/play_bible"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                app:useMaterialThemeColors="true" />

            <RadioGroup
                android:id="@+id/planRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/planMcCheyne"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="@string/mccheyne_plan"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <RadioButton
                    android:id="@+id/planSequential"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="@string/sequential_plan"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <RadioButton
                    android:id="@+id/planChapterADay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="@string/three_chapters_plan"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />
            </RadioGroup>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/bibleEnglish"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/bibleRecordedAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:checked="true"
                android:text="@string/recorded_bible"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                app:useMaterialThemeColors="true" />

            <TextView
                android:id="@+id/bibleAudioStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recorded_ready"
                android:textColor="@color/text_secondary"
                android:textSize="17sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/importBibleAudioButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:layout_marginTop="8dp"
                android:text="@string/import_recordings"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/chineseSpeechRateLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/speech_rate_natural"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <SeekBar
                android:id="@+id/chineseSpeechRate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:max="50"
                android:progress="18" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/moduleWeather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:checked="true"
                android:text="@string/play_weather"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                app:useMaterialThemeColors="true" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/moduleNews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:checked="true"
                android:text="@string/play_news"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                app:useMaterialThemeColors="true" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/newsFullArticles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:checked="false"
                android:text="@string/play_full_news"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                app:useMaterialThemeColors="true" />

            <TextView
                android:id="@+id/systemReadinessStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/checking_background"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:lineSpacingExtra="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backgroundProtectionButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:layout_marginTop="8dp"
                android:text="@string/background_protection"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/locationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/location_not_set"
                android:textColor="@color/text_secondary"
                android:textSize="17sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/locationButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:layout_marginTop="8dp"
                android:text="@string/allow_weather_location"
                android:textSize="18sp"
                android:visibility="gone" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="48dp" />
    </LinearLayout>
</ScrollView>
